{
  "version": "3.3",
  "output": {
    "path": "output/demo.mp4",
    "fps": 30,
    "duration": 20.0,
    "codec": "auto"
  },
  "resources": [
    {
      "id": "video_src",
      "source": "https://vjs.zencdn.net/v/oceans.mp4",
      "type": "video"
    },
    {
      "id": "img_1",
      "source": "nature_1.jpg",
      "type": "image"
    },
    {
      "id": "img_2",
      "source": "nature_2.jpg",
      "type": "image"
    },
    {
      "id": "ui_plate_png",
      "source": "local_assets/ui/plate_dark.png",
      "type": "image"
    },
    {
      "id": "black_bg",
      "source": "color=c=black:s=1080x1920:r=30",
      "type": "lavfi"
    },
    {
      "id": "music",
      "source": "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3",
      "type": "audio"
    }
  ],
  "pipeline": [
    {
      "id": "canvas",
      "input": "black_bg",
      "trim": { "start": 0, "end": 20 },
      "volume": 0,
      "actions": [
        { "type": "scale", "w": 1080, "h": 1920 }
      ]
    },
    {
      "id": "clip_1",
      "input": "video_src",
      "trim": { "start": 0, "end": 5.5 },
      "src_trim": { "start": 0, "end": 5.5 },
      "volume": 0,
      "actions": [
        { "type": "scale_and_crop", "w": 1080, "h": 1920 }
      ]
    },
    {
      "id": "clip_2",
      "input": "img_1",
      "trim": { "start": 4, "end": 9.5 },
      "volume": 0,
      "actions": [
        { "type": "scale_and_crop", "w": 1080, "h": 1920 },
        { "type": "dissolve", "duration": 1.5 }
      ]
    },
    {
      "id": "clip_3",
      "input": "video_src",
      "trim": { "start": 8, "end": 13.5 },
      "src_trim": { "start": 20, "end": 25.5 },
      "volume": 0,
      "actions": [
        { "type": "scale_and_crop", "w": 1080, "h": 1920 },
        { "type": "dissolve", "duration": 1.5 }
      ]
    },
    {
      "id": "clip_4",
      "input": "img_2",
      "trim": { "start": 12, "end": 17.5 },
      "volume": 0,
      "actions": [
        { "type": "scale_and_crop", "w": 1080, "h": 1920 },
        { "type": "dissolve", "duration": 1.5 }
      ]
    },
    {
      "id": "clip_5",
      "input": "video_src",
      "trim": { "start": 16, "end": 20 },
      "src_trim": { "start": 40, "end": 44 },
      "volume": 0,
      "actions": [
        { "type": "scale_and_crop", "w": 1080, "h": 1920 },
        { "type": "zoom", "zoom": 1.2, "smooth": true, "w": 1080, "h": 1920 },
        { "type": "dissolve", "duration": 1.5 }
      ]
    },
    {
      "id": "premium_title",
      "input": "ui_plate_png",
      "trim": { "start": 2, "end": 18 },
      "actions": [
        {
          "type": "drawtext",
          "text": "PREMIUM MULTI-RESOURCE MONTAGE",
          "fontsize": 40,
          "fontcolor": "white",
          "x": "(w-text_w)/2",
          "y": "80"
        },
        {
          "type": "drawtext",
          "text": "Video + AI Generated Images",
          "fontsize": 30,
          "fontcolor": "white@0.8",
          "x": "(w-text_w)/2",
          "y": "140"
        },
        { "type": "dissolve", "duration": 1.0 }
      ]
    }
  ],
  "compose": {
    "base": "canvas",
    "layers": [
      { "source": "clip_1", "pos": { "x": "0", "y": "0" } },
      { "source": "clip_2", "pos": { "x": "0", "y": "0" } },
      { "source": "clip_3", "pos": { "x": "0", "y": "0" } },
      { "source": "clip_4", "pos": { "x": "0", "y": "0" } },
      { "source": "clip_5", "pos": { "x": "0", "y": "0" } },
      { "source": "premium_title", "pos": { "x": "(W-w)/2", "y": "800" } }
    ]
  },
  "audio": [
    {
      "source": "music",
      "volume": 0.5,
      "fade_in": 2.0,
      "fade_out": 3.0
    }
  ]
}
