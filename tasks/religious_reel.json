{
  "version": "2.0",
  "output": {
    "path": "output/religious_video_abstract.mp4",
    "fps": 30,
    "duration": 43.6,
    "codec": "libx264"
  },
  "presets": {
    "bg_style": [
      { "type": "scale_and_crop", "w": 540, "h": 960 },
      { "type": "blur", "sigma": 15 },
      { "type": "zoom", "zoom": 1.4, "expr": "if(gt(on, 330), 1+(on-330)*(0.4/45), 1)" }
    ],
    "fg_style": [
      { "type": "scale_contain", "w": 540, "h": 960 },
      { "type": "zoom", "zoom": 1.3, "expr": "if(gt(on, 330), 1+(on-330)*(0.3/45), 1)" }
    ],
    "bg_style_first": [
      { "type": "scale_and_crop", "w": 540, "h": 960 },
      { "type": "blur", "sigma": 15 },
      { "type": "zoom", "zoom": 1.4, "expr": "if(gt(on, 315), 1+(on-315)*(0.4/45), 1)" }
    ],
    "fg_style_first": [
      { "type": "scale_contain", "w": 540, "h": 960 },
      { "type": "zoom", "zoom": 1.3, "expr": "if(gt(on, 315), 1+(on-315)*(0.3/45), 1)" }
    ]
  },
  "resources": [
    { "id": "canvas", "source": "color=c=black:s=540x960:d=43.6", "type": "lavfi" },
    { "id": "img1", "source": "https://pravoslavie.ru/sas/image/103040/304005.p.jpg", "type": "image" },
    { "id": "img2", "source": "https://pravoslavie.ru/sas/image/104454/445491.p.jpg", "type": "image" },
    { "id": "img3", "source": "https://pravoslavie.ru/sas/image/104446/444638.p.jpg", "type": "image" },
    { "id": "img4", "source": "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQLZP7_RLUmWl-2XDEs1CwLDT-N7xi2uoaOGA&s", "type": "image" },
    { "id": "audio", "source": "local_assets/008_arhimandrit_tornike_moseshvili.mp3", "type": "audio" }
  ],
  "pipeline": [
    { "id": "base_canvas", "input": "canvas", "actions": [{ "type": "setsar" }] },
    
    { "id": "bg1", "input": "img1", "preset": "bg_style_first", "trim": { "start": 0, "end": 12 } },
    { "id": "fg1", "input": "img1", "preset": "fg_style_first", "trim": { "start": 0, "end": 12 } },

    { "id": "bg2", "input": "img2", "preset": "bg_style", "trim": { "start": 10.5, "end": 23 }, 
      "actions": [{ "type": "fade_in", "duration": 1.5, "start_time": 0, "alpha": true }] 
    },
    { "id": "fg2", "input": "img2", "preset": "fg_style", "trim": { "start": 10.5, "end": 23 }, 
      "actions": [{ "type": "fade_in", "duration": 1.5, "start_time": 0, "alpha": true }]
    },

    { "id": "bg3", "input": "img3", "preset": "bg_style", "trim": { "start": 21.5, "end": 34 }, 
      "actions": [{ "type": "fade_in", "duration": 1.5, "start_time": 0, "alpha": true }]
    },
    { "id": "fg3", "input": "img3", "preset": "fg_style", "trim": { "start": 21.5, "end": 34 }, 
      "actions": [{ "type": "fade_in", "duration": 1.5, "start_time": 0, "alpha": true }]
    },

    { "id": "bg4", "input": "img4", "preset": "bg_style", "trim": { "start": 32.5, "end": 43.6 }, 
      "actions": [{ "type": "fade_in", "duration": 1.5, "start_time": 0, "alpha": true }] 
    },
    { "id": "fg4", "input": "img4", "preset": "fg_style", "trim": { "start": 32.5, "end": 43.6 }, 
      "actions": [
        { "type": "fade_in", "duration": 1.5, "start_time": 0, "alpha": true },
        {
          "type": "drawtext",
          "text": "AMEN",
          "fontsize": 120,
          "fontcolor": "gold",
          "fontfile": "https://github.com/googlefonts/roboto/raw/main/src/hinted/Roboto-Regular.ttf",
          "x": "(w-text_w)/2",
          "y": "(h-text_h)/2"
        }
      ] 
    }

  ],
  "compose": {
    "base": "base_canvas",
    "layers": [
      { "source": "bg1" }, { "source": "fg1" },
      { "source": "bg2" }, { "source": "fg2" },
      { "source": "bg3" }, { "source": "fg3" },
      { "source": "bg4" }, { "source": "fg4" }
    ]
  },
  "audio": { "source": "audio", "volume": 1.0, "fade_in": 1.5, "fade_out": 2.5 }
}
