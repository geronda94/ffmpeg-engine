{
  "version": "2.0",
  "output": {
    "path": "output/n8n_promo_reel.mp4",
    "fps": 30,
    "duration": 12.0,
    "codec": "libx264",
    "preset": "fast",
    "crf": 23
  },
  "presets": {
    "bg_style": [
      { "type": "scale_and_crop", "w": 540, "h": 960 },
      { "type": "blur", "sigma": 15 },
      { "type": "zoom", "zoom": 1.3, "smooth": true }
    ]
  },
  "resources": [
    { "id": "canvas", "source": "color=c=black:s=540x960:d=12", "type": "lavfi" },
    { "id": "img1", "source": "https://images.unsplash.com/photo-1518770660439-4636190af475?w=1080&auto=format&fit=crop", "type": "image" },
    { "id": "img2", "source": "https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1080&auto=format&fit=crop", "type": "image" },
    { "id": "img3", "source": "https://images.unsplash.com/photo-1526304640581-d334cdbbf45e?w=1080&auto=format&fit=crop", "type": "image" }
  ],
  "pipeline": [
    { "id": "base", "input": "canvas", "actions": [{ "type": "setsar" }] },
    
    { 
      "id": "bg1", "input": "img1", "preset": "bg_style", "trim": { "start": 0, "end": 4.5 },
      "actions": [{ "type": "fade_out", "duration": 1.0, "start_time": 3.5, "alpha": true }] 
    },
    { 
      "id": "fg1", "input": "img1", "trim": { "start": 0, "end": 4.5 },
      "actions": [
        { "type": "scale_contain", "w": 540, "h": 960 },
        { "type": "zoom", "zoom": 1.15, "smooth": true },
        { "type": "drawtext", "text": "N8N + FFMPEG", "fontfile": "https://github.com/googlefonts/montserrat/raw/main/fonts/ttf/Montserrat-Black.ttf", "fontsize": 65, "fontcolor": "white", "x": "(w-text_w)/2", "y": "(h-text_h)/2-100" },
        { "type": "fade_out", "duration": 1.0, "start_time": 3.5, "alpha": true }
      ] 
    },

    { 
      "id": "bg2", "input": "img2", "preset": "bg_style", "trim": { "start": 3.5, "end": 8.5 },
      "actions": [
        { "type": "fade_in", "duration": 1.0, "start_time": 0, "alpha": true },
        { "type": "fade_out", "duration": 1.0, "start_time": 4.0, "alpha": true }
      ] 
    },
    { 
      "id": "fg2", "input": "img2", "trim": { "start": 3.5, "end": 8.5 },
      "actions": [
        { "type": "scale_contain", "w": 540, "h": 960 },
        { "type": "zoom", "zoom": 1.15, "smooth": true },
        { "type": "drawtext", "text": "FULL CONTROL", "fontfile": "https://github.com/googlefonts/montserrat/raw/main/fonts/ttf/Montserrat-Black.ttf", "fontsize": 65, "fontcolor": "gold", "x": "(w-text_w)/2", "y": "(h-text_h)/2-100" },
        { "type": "fade_in", "duration": 1.0, "start_time": 0, "alpha": true },
        { "type": "fade_out", "duration": 1.0, "start_time": 4.0, "alpha": true }
      ] 
    },

    { 
      "id": "bg3", "input": "img3", "preset": "bg_style", "trim": { "start": 7.5, "end": 12.0 },
      "actions": [{ "type": "fade_in", "duration": 1.0, "start_time": 0, "alpha": true }] 
    },
    { 
      "id": "fg3", "input": "img3", "trim": { "start": 7.5, "end": 12.0 },
      "actions": [
        { "type": "scale_contain", "w": 540, "h": 960 },
        { "type": "zoom", "zoom": 1.15, "smooth": true },
        { "type": "drawtext", "text": "ZERO COST", "fontfile": "https://github.com/googlefonts/montserrat/raw/main/fonts/ttf/Montserrat-Black.ttf", "fontsize": 80, "fontcolor": "#00FF66", "x": "(w-text_w)/2", "y": "(h-text_h)/2-100" },
        { "type": "fade_in", "duration": 1.0, "start_time": 0, "alpha": true }
      ] 
    }
  ],
  "compose": {
    "base": "base",
    "layers": [
      { "source": "bg1" }, { "source": "fg1" },
      { "source": "bg2" }, { "source": "fg2" },
      { "source": "bg3" }, { "source": "fg3" }
    ]
  }
}