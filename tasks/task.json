{
  "version": "3.2",
  "output": {
    "path": "output/premium_demo.mp4",
    "fps": 30,
    "duration": 10.0,
    "codec": "auto"
  },
  "resources": [
    {
      "id": "bg_video",
      "source": "https://vjs.zencdn.net/v/oceans.mp4",
      "type": "video"
    },
    {
      "id": "music",
      "source": "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3",
      "type": "audio"
    }
  ],
  "pipeline": [
    {
      "id": "main_bg",
      "input": "bg_video",
      "trim": { "start": 0, "end": 10 },
      "volume": 0.0,
      "actions": [
        { "type": "scale_and_crop", "w": 1080, "h": 1920 },
        { "type": "zoom", "zoom": 1.08, "smooth": true, "w": 1080, "h": 1920 }
      ]
    },
    {
      "id": "text_layer",
      "input": "bg_video",
      "trim": { "start": 2, "end": 9 },
      "volume": 0.0,
      "actions": [
        { "type": "scale_and_crop", "w": 1080, "h": 1920 },
        {
          "type": "plate",
          "w": 880,
          "h": 220,
          "x": "100",
          "y": "800",
          "blur": 25,
          "radius": 36,
          "boxcolor": "white@0.12",
          "border_width": 2,
          "border_color": "white@0.5",
          "glow_color": "white@0.18",
          "glow_width": 18
        },
        {
          "type": "drawtext",
          "text": "PREMIUM ENGINE",
          "fontsize": 72,
          "fontcolor": "white",
          "x": "(w-text_w)/2",
          "y": "870"
        },
        { "type": "dissolve", "duration": 1.2 }
      ]
    }
  ],
  "compose": {
    "base": "main_bg",
    "layers": [
      {
        "source": "text_layer",
        "pos": { "x": "0", "y": "0" }
      }
    ]
  },
  "audio": [
    {
      "source": "music",
      "volume": 0.7,
      "fade_in": 1.5,
      "fade_out": 2.0
    }
  ]
}