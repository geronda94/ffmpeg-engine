{
  "vertical": [
    {
      "id": "v_no_effects",
      "name": "🚫 Без эффектов",
      "description": "Чистый монтаж без наложения эффектов и переходов.",
      "resize_mode": "fit",
      "effects": [],
      "transition": { "type": "cut", "duration": 0 }
    },
    {
      "id": "v_smooth_story",
      "name": "📖 Плавный сторителлинг",
