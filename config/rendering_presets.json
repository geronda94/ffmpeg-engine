      "resize_mode": "fit",
      "effects": [
        {"type": "ken_burns", "zoom_from": 1.0, "zoom_to": 1.12, "start_frac": 0.15, "end_frac": 0.75}
      ],
      "transition": { "type": "crossfade", "duration": 0.5 }
    },
    {
      "id": "v_dynamic_shorts",
      "name": "⚡ Динамичный Shorts",
