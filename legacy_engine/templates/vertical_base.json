{
  "version": "3.3",
  "output": {
    "path": "output/generated_reel.mp4",
    "fps": 30,
    "w": 1080,
    "h": 1920
  },
  "resources": [
    { "id": "ui_plate", "source": "local_assets/ui/plate_anthracite_noise.png", "type": "image" },
    { "id": "black_bg", "source": "color=c=black:s=1080x1920:r=30", "type": "lavfi" }
  ],
  "pipeline": [
    {
      "id": "canvas",
      "input": "black_bg",
      "trim": { "start": 0, "end": 60 },
      "actions": [{ "type": "scale", "w": 1080, "h": 1920 }]
    },
    {
      "id": "ui_layer",
      "input": "ui_plate",
      "trim": { "start": 1, "end": 59 },
      "actions": [
        { "type": "fade_in", "duration": 1.0, "alpha": true },
        { "type": "fade_out", "duration": 1.0, "alpha": true }
      ]
    }
  ],
  "compose": {
    "base": "canvas",
    "layers": [
      { "source": "ui_layer", "pos": { "x": "(W-w)/2", "y": "1550" } }
    ]
  }
}
