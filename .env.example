# Content Factory — Environment Variables
# Copy this file to .env and fill in your actual keys

# DeepSeek API (LLM for script generation, storyboarding, scoring, translation)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Bot Tokens
# Main bot (for manual/interactive content creation)
TELEGRAM_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Auto bot (for automated content pipeline). Falls back to TELEGRAM_BOT_TOKEN if not set.
TELEGRAM_AUTO_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stock Photo APIs (image search)
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PIXABAY_API_KEY=xxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxx
